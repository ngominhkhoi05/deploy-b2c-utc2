# =====================================================================
# Flash Sale B2C - Deployment Environment Variables (TEMPLATE)
# =====================================================================
# Mục đích: Mẫu các biến môi trường cần thiết để chạy backend + frontend
# + redis trên VPS. KHÔNG chứa giá trị thật — commit file này lên Git
# được, nhưng KHÔNG BAO GIỜ commit `.env` / `db.env` thật.
#
# Cách dùng (trên VPS):
#   1. cp .env.example .env
#   2. Điền giá trị thật vào các chỗ <...>
#   3. Khởi động: ./scripts/deploy.sh
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# PHẦN 1 — VPS / APP INFO
# =====================================================================
# IP VPS public (user truy cập qua http://<VPS_IP>).
# Ví dụ: 172.20.10.5
VPS_IP=<VPS_IP>

# Chạy backend với profile prod (đọc application-prod.yaml).
SPRING_PROFILES_ACTIVE=prod

# Java options cho Spring Boot container.
JAVA_OPTS=-Xmx1024m -Xms512m -XX:+UseG1GC

# ─────────────────────────────────────────────────────────────────────
# PHẦN 2 — DATABASE (Supabase PostgreSQL)
# =====================================================================
# Database là Supabase Cloud DB — KHÔNG chạy Postgres trong container.
# Lấy thông tin ở: Supabase Dashboard → Project → Settings → Database.
#
# LƯU Ý:
#   - Với Supabase, dùng "Connection Pooler" host (port 6543, transaction
#     mode) cho backend — hoặc "Direct connection" (port 5432) tuỳ case.
#   - sslmode=require BẮT BUỘC với Supabase (đã set trong application-prod.yaml).
DB_HOST=<SUPABASE_DB_HOST>.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=postgres.<SUPABASE_PROJECT_REF>
DB_PASSWORD=<SUPABASE_DB_PASSWORD>
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ─────────────────────────────────────────────────────────────────────
# PHẦN 3 — REDIS (chạy trong Docker container)
# =====================================================================
# Service name trong docker-compose network — KHÔNG đổi.
REDIS_HOST=redis
REDIS_PORT=6379
# Đặt password nếu muốn bảo vệ Redis. Để trống = không có password.
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# PHẦN 4 — JWT
# =====================================================================
# Tối thiểu 64 ký tự ngẫu nhiên (HMAC-SHA256 yêu cầu >= 32 bytes).
# Tạo bằng: openssl rand -base64 64
JWT_SECRET=<64-char-base64-random-secret>
# ⚠️ KHÔNG viết comment inline sau dấu "=" (vd: "3600000  # 1 gio").
# Docker Compose đọc nguyên cả phần sau "=" → giá trị sẽ bị dính comment.
# Comment phải nằm trên DÒNG RIÊNG như các dòng này.
JWT_EXPIRATION_MS=3600000
# 1 giờ
JWT_REFRESH_EXPIRATION_MS=604800000
# 7 ngày

# ─────────────────────────────────────────────────────────────────────
# PHẦN 5 — CORS (FE được phép gọi API)
# =====================================================================
# Danh sách origin FE được phép gọi API (comma-separated).
# Phân tách bằng dấu phẩy, KHÔNG có dấu "/" cuối.
#
# Khi deploy qua Nginx (FE + BE cùng origin http://<VPS_IP>) thì
# same-origin KHÔNG cần CORS — nhưng vẫn nên khai để chắc chắn.
#
# Thêm http://localhost:3000 để dev có thể chạy FE local (npm run dev)
# gọi thẳng BE public qua IP mà không bị CORS block (BE fix ở
# commit dfe0098 — whitelist theo CorsConfig). Thêm port khác nếu có.
#
# ⚠️ Biến này đã map vào property "cors.allowed-origins" trong
# application-prod.yaml. Sau khi sửa phải RECREATE backend:
#   docker compose up -d --force-recreate backend
CORS_ALLOWED_ORIGINS=http://<VPS_IP>,http://localhost:3000

# ─────────────────────────────────────────────────────────────────────
# PHẦN 6 — WEBSOCKET / REALTIME
# =====================================================================
# ⚠️ Backend KHÔNG đọc biến WS_ENDPOINT. Endpoint được hard-code trong
# WebSocketConfig.java là "/ws". Biến này chỉ mang tính tài liệu.
# FE kết nối qua:  ws://<VPS_IP>/ws?token=<JWT>
WS_ENDPOINT=/ws

# ─────────────────────────────────────────────────────────────────────
# PHẦN 7 — CLOUDINARY (lưu ảnh user / product)
# =====================================================================
# ⚠️ Repo backend HIỆN CHƯA có code Cloudinary (grep không match).
# Giữ biến để sẵn sàng, nhưng backend sẽ BỎ QUA các biến này.
# Lấy ở https://console.cloudinary.com/ khi bắt đầu dùng.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder gom ảnh của môi trường này.
CLOUDINARY_FOLDER=flash-sale-b2c/prod

# ─────────────────────────────────────────────────────────────────────
# PHẦN 8 — PAYMENT (nếu có)
# =====================================================================
# ⚠️ Repo backend HIỆN CHƯA có tích hợp payment gateway.
# Placeholder — điền khi có code đọc các biến này.
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# ─────────────────────────────────────────────────────────────────────
# PHẦN 9 — TZ / LOCALE
# =====================================================================
TZ=Asia/Ho_Chi_Minh

# ─────────────────────────────────────────────────────────────────────
# PHẦN 10 — FRONTEND (Next.js, build-time)
# =====================================================================
# ⚠️ TẤT CẢ biến NEXT_PUBLIC_* là BUILD-TIME trong Next.js — chúng được
# embed vào JS bundle lúc `next build`, KHÔNG đọc runtime.
# Khi build image frontend, phải pass --build-arg cho từng biến (xem
# scripts/migrate-to-new-frontend.sh).
#
# Khi đổi giá trị bất kỳ biến nào dưới → BẮT BUỘC rebuild frontend:
#   docker build --build-arg ... -t flash-sale-b2c-frontend:latest \
#       -f docker/frontend.Dockerfile <FE_REPO_PATH>
#   docker compose up -d --force-recreate frontend
#
# KHÔNG cần (và KHÔNG nên) thêm các biến này vào env_file của service
# frontend trong docker-compose.yml — chúng chỉ dùng khi build image.
# =====================================================================

# Base URL API mà FE gọi (tương đối khi qua Nginx, hoặc tuyệt đối).
# Qua Nginx reverse proxy cùng origin → /api/v1 (relative, đổi domain
# không cần rebuild).
NEXT_PUBLIC_API_URL=/api/v1

# Base URL WebSocket. Để TRỐNG → SockJS tự dùng window.location.host
# (khuyến nghị khi qua Nginx cùng origin).
NEXT_PUBLIC_WS_URL=

# Bật/tắt mock data layer. false = gọi API thật (production).
# true = dùng mock (chỉ dành cho dev offline).
NEXT_PUBLIC_USE_MOCK=false

# Base URL tuyệt đối cho OG tags, sitemap, canonical URL. Build-time.
# Ví dụ: http://180.93.137.28 hoặc https://your-domain.com.
NEXT_PUBLIC_SITE_URL=http://<VPS_IP>

# Locale mặc định của UI: vi (mặc định) | en. Build-time.
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# ⚠️ STITCH_API_KEY KHÔNG có ở đây — key này chỉ dùng cho Cursor MCP
# (Stitch tool) ở máy dev, đọc từ flash-sale-b2c-fe/.env local. FE
# runtime (Next.js bundle) không cần key này.