# =====================================================================
# .gitignore cho thư mục deploy-b2c-utc2
# =====================================================================
# Mục đích: Bảo vệ secret + file backup + log khỏi bị commit nhầm.
# Repo này có thể public/private tuỳ bạn — nhưng secret PHẢI được ignore.
# =====================================================================

# ── File bí mật (TUYỆT ĐỐI KHÔNG COMMIT) ────────────────────────────────
.env
.env.*
!.env.example
db.env
redis.env
*.env.local
*.env.production
*.env.staging

# Cloudinary / OAuth / Payment secret nếu tách file
cloudinary.env
oauth.env
secrets/

# ── PEM / Key / Certificate ─────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
*.jks
keystore.*
truststore.*

# ── Backup & Dump (DB / Redis) ─────────────────────────────────────────
db/backups/
*.sql
*.sql.gz
*.dump
*.backup
*.rdb
*.aof

# ── OpenSearch TLS material (generated on the VPS) ────────────────────
# CA + truststore của OpenSearch được SINH RA trên VPS bằng
# scripts/export-opensearch-ca.sh + scripts/build-truststore.sh, KHÔNG
# commit lên git:
#   - CA được export từ image OpenSearch (chứa private key của CA), nên
#     commit vào repo sẽ làm lộ private key.
#   - Truststore phụ thuộc đúng image đang chạy; commit vào repo sẽ dễ
#     lệch CA sau khi rebuild image.
# Thư mục này được mount vào container backend (read-only).
secrets/opensearch/

# ── Docker artifacts ──────────────────────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml
*.override.yml
*.local.yml

# ── Editor / IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.iml

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Log files ─────────────────────────────────────────────────────────
*.log
logs/
logs/*.log
docker-compose.log

# ── Build / runtime output ────────────────────────────────────────────
build/
dist/
node_modules/
.next/
out/
.gradle/